#!/usr/bin/env python3

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")

import http.server
import json
import os
import pathlib
import socketserver
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

from gi.repository import Gdk, Gtk, WebKit2

APP_DIR = pathlib.Path(__file__).resolve().parent
STATIC_DIR = APP_DIR / "app"
CACHE_DIR = pathlib.Path.home() / ".cache" / "hackscroll"
CACHE_DIR.mkdir(parents=True, exist_ok=True)

USER_AGENT = "HackScroll/1.0 Linux RSS Reader"
FEED_BASE = "https://hackaday.com/feed/"
SEARCH_BASE = "https://hackaday.com/wp-json/wp/v2/posts"


def fetch_text(url):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=15) as resp:
        charset = resp.headers.get_content_charset() or "utf-8"
        return resp.read().decode(charset)


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        qs = urllib.parse.parse_qs(parsed.query)

        if parsed.path == "/api/feed":
            self._feed(qs)
            return
        if parsed.path == "/api/search":
            self._search(qs)
            return
        if parsed.path == "/api/open":
            self._open(qs)
            return

        self._static(parsed.path)

    def _feed(self, qs):
        page = max(1, int(qs.get("page", ["1"])[0]))
        url = f"{FEED_BASE}?paged={page}"
        cache_file = CACHE_DIR / f"feed_page_{page}.xml"
        body = None
        cached = False

        try:
            body = fetch_text(url)
            cache_file.write_text(body, encoding="utf-8")
        except Exception:
            if cache_file.exists():
                body = cache_file.read_text(encoding="utf-8")
                cached = True

        if body is None:
            self.send_error(502)
            return

        self.send_response(200)
        self.send_header("Content-Type", "application/xml; charset=utf-8")
        if cached:
            self.send_header("X-HackScroll-Cached", "1")
        self.end_headers()
        self.wfile.write(body.encode("utf-8"))

    def _search(self, qs):
        query = qs.get("q", [""])[0].strip()
        page = max(1, int(qs.get("page", ["1"])[0]))
        if not query:
            self.send_error(400)
            return

        encoded = urllib.parse.quote(query)
        url = f"{SEARCH_BASE}?search={encoded}&per_page=20&page={page}&_embed"
        try:
            body = fetch_text(url)
        except Exception:
            body = None

        if body is None:
            self.send_error(502)
            return

        self.send_response(200)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.end_headers()
        self.wfile.write(body.encode("utf-8"))

    def _open(self, qs):
        url = qs.get("url", [""])[0].strip()
        if url:
            subprocess.Popen(
                ["xdg-open", url],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        self.send_response(204)
        self.end_headers()

    def _static(self, path):
        if path == "/":
            path = "/index.html"
        target = (STATIC_DIR / path.lstrip("/")).resolve()
        if not str(target).startswith(str(STATIC_DIR)) or not target.is_file():
            self.send_error(404)
            return

        content_type = "application/octet-stream"
        if target.suffix == ".html":
            content_type = "text/html; charset=utf-8"
        elif target.suffix == ".css":
            content_type = "text/css; charset=utf-8"
        elif target.suffix == ".js":
            content_type = "application/javascript; charset=utf-8"
        elif target.suffix == ".svg":
            content_type = "image/svg+xml"

        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        self.wfile.write(target.read_bytes())


class ThreadingHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    allow_reuse_address = True
    daemon_threads = True


def start_server():
    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


def main():
    normal_view = "--normal" in sys.argv

    server = start_server()
    port = server.server_address[1]

    Gtk.init(sys.argv)
    win = Gtk.Window(title="HackScroll")

    display = Gdk.Display.get_default()
    mon = display.get_primary_monitor() or display.get_monitor(0)
    geom = mon.get_geometry()

    if normal_view:
        default_h = min(720, max(480, geom.height - 120))
        default_w = min(1280, int(default_h * 1.6))
        win.set_type_hint(Gdk.WindowTypeHint.NORMAL)
    else:
        default_h = min(900, max(480, geom.height - 80))
        default_w = int(default_h * (480 / 900))
        win.set_type_hint(Gdk.WindowTypeHint.DIALOG)

    win.set_default_size(default_w, default_h)
    win.set_resizable(True)
    win.set_position(Gtk.WindowPosition.CENTER)
    win.set_icon_from_file(str(STATIC_DIR / "icon.svg"))

    dm = WebKit2.WebsiteDataManager.new_ephemeral()
    context = WebKit2.WebContext.new_with_website_data_manager(dm)
    context.set_cache_model(WebKit2.CacheModel.DOCUMENT_VIEWER)

    ucm = WebKit2.UserContentManager()
    ucm.register_script_message_handler("openLink")

    def on_open_link(ucm, js_result):
        url = js_result.get_js_value().to_string()
        if url:
            Gtk.show_uri_on_window(win, url, Gdk.CURRENT_TIME)

    ucm.connect("script-message-received::openLink", on_open_link)

    view = WebKit2.WebView(web_context=context, user_content_manager=ucm)
    settings = view.get_settings()
    settings.set_enable_javascript(True)
    settings.set_enable_developer_extras(True)
    settings.set_enable_html5_local_storage(True)

    view.load_uri(f"http://127.0.0.1:{port}/?v={int(time.time())}")
    win.add(view)

    def on_destroy(_):
        server.shutdown()
        Gtk.main_quit()

    win.connect("destroy", on_destroy)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
